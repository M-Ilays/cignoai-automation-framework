{
  "name": "cigno-fe-qa",
  "version": "1.0.0",
  "description": "Playwright test automation framework for Cigno",
  "main": "index.js",
  "scripts": {
    "clean:allure": "rimraf allure-results",
    "allure:copy:history": "copyfiles -u 1 allure-report/history/** allure-results",
    "allure:generate": "npm run allure:copy:history && node scripts/allure-run.mjs generate allure-results --clean",
    "allure:open": "node scripts/allure-run.mjs open allure-report",
    "test": "cross-env SKIP_GLOBAL_LOGIN=true npx playwright test",
    "test:fast": "cross-env SKIP_GLOBAL_LOGIN=true npx playwright test --project=Chromium --grep-invert @slow",
    "test:fast:quick": "cross-env SKIP_GLOBAL_LOGIN=true E2E_FAST=1 npx playwright test --project=Chromium --grep-invert @slow",
    "test:slow": "cross-env SKIP_GLOBAL_LOGIN=true npx playwright test --project=Chromium --grep @slow",
    "test:slow:quick": "cross-env SKIP_GLOBAL_LOGIN=true E2E_FAST=1 npx playwright test --project=Chromium --grep @slow",
    "test:refresh-session": "cross-env SKIP_GLOBAL_LOGIN=false npx playwright test --project=setup",
    "test:clean": "npm run clean:allure && npm run test && npm run allure:generate || echo 'Test run has failures. Check the report for details.'",
    "test:allure": "npm-run-all --continue-on-error -s test:clean allure:generate",
    "test:allure:open": "npm-run-all --continue-on-error -s test:clean allure:generate allure:open",
    "allure:serve:static": "npm run allure:generate && http-server ./allure-report -p 3000",
    "artillery:login": "artillery run src/artillery/logist.artillery.ts",
    "artillery:login:headless": "artillery run src/artillery/login-test.artillery.ts --headless"
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "author": "Cigno QA",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@graphql-codegen/cli": "^2.2.2",
    "@graphql-codegen/fragment-matcher": "^1.9.1",
    "@graphql-codegen/introspection": "^1.18.1",
    "@graphql-codegen/typescript": "^1.21.1",
    "@graphql-codegen/typescript-apollo-angular": "1.1.3",
    "@graphql-codegen/typescript-operations": "^1.17.15",
    "@graphql-codegen/typescript-react-apollo": "^2.2.3",
    "@graphql-codegen/typescript-resolvers": "1.1.3",
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^2.6.0",
    "@stylistic/eslint-plugin-ts": "^2.4.0",
    "@types/node": "^20.14.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "2.15.1",
    "artillery": "^2.0.21",
    "artillery-engine-playwright": "^1.20.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.47.0",
    "eslint-plugin-graphql": "^4.0.0",
    "eslint-plugin-jsdoc": "^48.10.2",
    "eslint-plugin-perfectionist": "^3.0.0",
    "eslint-plugin-playwright": "^0.15.3",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-tsdoc": "^0.3.0",
    "graphql-tag": "^2.0.0",
    "http-server": "^14.1.1",
    "lint-staged": "^15.2.7",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.50.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "5.3",
    "typescript-eslint": "^7.18.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "graphql": "^15.5.0",
    "graphql-request": "^3.1.0",
    "otpauth": "^9.3.6",
    "twilio": "^5.6.0"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "https://millsoft0745@dev.azure.com/millsoft0745/DM-Clinical-Research/_git/Comtrak_FE_QA"
  },
  "keywords": [],
  "type": "commonjs"
}
